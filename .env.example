# Optional. Base URL of the College Board question bank API.
# The app calls the documented endpoints directly from the browser by default
# (the API currently sends `Access-Control-Allow-Origin: *`). Only set this if
# you need to route requests through your own CORS proxy. No API key or secret
# is required by the question bank.
VITE_QBANK_API_BASE=https://qbank-api.collegeboard.org/msreportingquestionbank-prod/questionbank/digital
